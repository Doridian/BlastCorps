diff --git a/libmupen64plus/mupen64plus-core/src/r4300/fpu.h b/libmupen64plus/mupen64plus-core/src/r4300/fpu.h
index 8f4ddce8f..61c79f02f 100644
--- a/libmupen64plus/mupen64plus-core/src/r4300/fpu.h
+++ b/libmupen64plus/mupen64plus-core/src/r4300/fpu.h
@@ -42,6 +42,17 @@
 #else
   #define M64P_FPU_INLINE static inline
   #include <fenv.h>
+  /* BizHawk builds with MSVC, which takes the definitions above over its
+     own: round half up, and trunc through int.  They round differently from
+     C99's, and a movie only syncs with them. */
+  static inline double msvc_round(double x) { return floor(x + 0.5); }
+  static inline float msvc_roundf(float x) { return (float) floor(x + 0.5); }
+  static inline double msvc_trunc(double x) { return (double) (int) x; }
+  static inline float msvc_truncf(float x) { return (float) (int) x; }
+  #define round msvc_round
+  #define roundf msvc_roundf
+  #define trunc msvc_trunc
+  #define truncf msvc_truncf
 #endif
 
 
